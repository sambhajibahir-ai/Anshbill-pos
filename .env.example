# Copy to .env (or set these in your process manager)
PORT=4000
TZ=Asia/Kolkata
# REQUIRED in production - use a long random string
JWT_SECRET=change-me-to-a-long-random-string
# Password for the initial "admin" user (used only when the database is first created)
ADMIN_PASSWORD=admin123
# SQLite database file (default: server/data/anshbill.db)
# DB_PATH=./server/data/anshbill.db
# Comma-separated allowed origins, only needed if the UI is hosted on another domain
# CORS_ORIGIN=https://pos.example.com

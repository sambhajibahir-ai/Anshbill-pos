{
  "name": "atbsoftware-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ATB Software POS - retail billing with GST invoices, barcode scanning, stock alerts and daily sales reports",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:api": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "test": "node --disable-warning=ExperimentalWarning --test \"shared/**/*.test.js\" \"server/test/**/*.test.js\"",
    "desktop:start": "npm run start --prefix desktop-app",
    "desktop:dist": "npm run dist:win --prefix desktop-app"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

